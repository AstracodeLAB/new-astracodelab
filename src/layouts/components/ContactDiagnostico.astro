---
import TitleSecondary from './Titles/TitleSecondary.astro';
import Buttons from './Buttons/Buttons.astro';
---

<section id='contact' class='contact'>
  <div class='contact__card'>
    <div class='contact__card-top'>
      <div class='contact__card-top-title'>
        <TitleSecondary text='Te llamamos nosotras' />
      </div>
      <p class='contact__card-top-text'>
        Déjanos tu nombre y tu teléfono. En menos de 24h te llamamos, sin compromiso,
        para contarte si de verdad merece la pena dar el salto.
      </p>
      <p class='contact__card-top-text'>
        Si prefieres que te escribamos primero, déjanos también tu email — pero lo
        normal es que te llamemos directamente.
      </p>
    </div>

    <div class='contact__card-bottom'>
      <form class='contact__form' action='https://formspree.io/f/xzzaoaya' method='POST'>
        <input type='hidden' name='redirect' value='https://astracodelab.com/sent' />
        <input type='hidden' name='source' value='landing-diagnostico-no-code' />

        <div class='contact__form-field'>
          <input
            type='text'
            id='name'
            name='name'
            placeholder='Nombre'
            aria-label='Nombre'
            minlength='3'
            maxlength='50'
            required
          />
        </div>
        <div class='contact__form-field'>
          <input
            type='tel'
            id='phone'
            name='phone'
            placeholder='Tu teléfono'
            aria-label='Teléfono'
            minlength='9'
            maxlength='20'
            required
          />
        </div>
        <div class='contact__form-field'>
          <input
            type='email'
            id='email'
            name='email'
            placeholder='Email (opcional)'
            aria-label='Correo electrónico'
          />
        </div>
        <div class='contact__form-field'>
          <input
            type='text'
            id='current-setup'
            name='current-setup'
            placeholder='¿Qué tienes montado ahora mismo? (opcional)'
            aria-label='Qué tienes montado ahora mismo'
            maxlength='150'
          />
        </div>
        <div class='contact__form-field contact__form-field--checkbox'>
          <input
            id='privacy'
            name='privacy'
            type='checkbox'
            aria-label='Acepto que se traten mis datos para gestionar la consulta'
            required
          />
          <label for='privacy' class='contact__form-label'>
            Acepto que se traten mis datos para gestionar la consulta.
          </label>
        </div>
        <div class='contact__form-actions'>
          <Buttons type='submit' className='btnSecondaryDark'>Sí, llamadme</Buttons>
        </div>
      </form>
    </div>
  </div>
</section>