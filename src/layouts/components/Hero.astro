---
import TitlesHero from '../components/Titles/TitlesHero.astro';
import Buttons from '../components/Buttons/Buttons.astro';
import RocketIllustration from './RocketIllustration.astro';
---

<div class='sectionHero'>
  <article class='sectionHero__content'>
    <div class='sectionHero__content-text'>
      <TitlesHero
        title={'Dise\u00f1amos webs profesionales para que tu negocio gane confianza y clientes'}
        subtitle=''
        className='heroHome--home'
      />

      <p class='sectionHero__content-description'>
        Dise&ntilde;amos webs profesionales para que tu negocio gane confianza y clientes. Ideal para aut&oacute;nomos y peque&ntilde;os negocios
        que no tienen tiempo ni ganas de meterse en l&iacute;os t&eacute;cnicos: nosotras nos encargamos de todo, de principio a fin.
      </p>
      <article class='sectionHero__buttons'>
        <Buttons className='btnPricingCta' href='https://calendly.com/astracodelab'>Agendar cita</Buttons>
        <Buttons className='btnHeroSecondary' href='/#contact'>Cu&eacute;ntanos tu proyecto</Buttons>
      </article>
    </div>
    <div class='sectionHero__image'>
      <RocketIllustration />
    </div>
  </article>
</div>
